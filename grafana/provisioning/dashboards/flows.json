      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Flows" }]
      },
      "title": "TLS Destinations by SNI",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT\n  f.\"serverName\" AS \"SNI\",\n  f.\"dstIp\" AS \"Destination IP\",\n  COALESCE(g.country, 'Unknown') AS \"Country\",\n  COALESCE(g.isp, 'Unknown') AS \"ISP\",\n  count(*) AS \"Flows\",\n  sum(f.bytes)::bigint AS \"Bytes\",\n  max(f.\"startedAt\") AS \"Last Seen\"\nFROM \"NetworkFlow\" f\nLEFT JOIN \"IpGeoCache\" g ON f.\"dstIp\" = g.ip\nWHERE $__timeFilter(f.\"startedAt\") AND f.\"serverName\" IS NOT NULL\nGROUP BY 1,2,3,4\nORDER BY \"Flows\" DESC\nLIMIT 60",
          "refId": "A"
        }
      ]
    }
