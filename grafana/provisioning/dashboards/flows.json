      "title": "Flows Over Time (by Device)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(f.\"startedAt\", $__interval),\n  COALESCE(d.name, f.\"srcIp\") AS metric,\n  count(*) AS value\nFROM \"NetworkFlow\" f\nLEFT JOIN \"Device\" d ON f.\"deviceId\" = d.id\nWHERE $__timeFilter(f.\"startedAt\")\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Bytes" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Flows" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Bytes" }]
      },
      "title": "Top Destination IPs by Bytes",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(d.name, f.\"srcIp\") AS \"Device\",\n  f.\"dstIp\" AS \"Destination IP\",\n  COALESCE(f.\"serverName\", '<no SNI>') AS \"SNI\",\n  COALESCE(g.country, 'Unknown') AS \"Country\",\n  COALESCE(g.isp, 'Unknown') AS \"ISP\",\n  f.\"dstPort\" AS \"Port\",\n  f.protocol AS \"Protocol\",\n  sum(f.bytes)::bigint AS \"Bytes\",\n  count(*) AS \"Flows\",\n  max(f.\"startedAt\") AS \"Last Seen\"\nFROM \"NetworkFlow\" f\nLEFT JOIN \"Device\" d ON f.\"deviceId\" = d.id\nLEFT JOIN \"IpGeoCache\" g ON f.\"dstIp\" = g.ip\nWHERE $__timeFilter(f.\"startedAt\")\nGROUP BY 1,2,3,4,5,6,7\nORDER BY \"Bytes\" DESC\nLIMIT 50",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Flows" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 22 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Flows" }]
      },
      "title": "Connections With No DNS Trail",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(d.name, f.\"srcIp\") AS \"Device\",\n  f.\"dstIp\" AS \"Destination IP\",\n  COALESCE(f.\"serverName\", '<no SNI>') AS \"SNI\",\n  COALESCE(g.country, 'Unknown') AS \"Country\",\n  COALESCE(g.isp, 'Unknown') AS \"ISP\",\n  f.\"dstPort\" AS \"Port\",\n  f.protocol AS \"Protocol\",\n  count(*) AS \"Flows\",\n  max(f.\"startedAt\") AS \"Last Seen\"\nFROM \"NetworkFlow\" f\nLEFT JOIN \"Device\" d ON f.\"deviceId\" = d.id\nLEFT JOIN \"IpGeoCache\" g ON f.\"dstIp\" = g.ip\nWHERE $__timeFilter(f.\"startedAt\") AND f.\"hadDnsQuery\" = false\nGROUP BY 1,2,3,4,5,6,7\nORDER BY \"Flows\" DESC\nLIMIT 50",
          "refId": "A"
        }
      ]
    },
    {
