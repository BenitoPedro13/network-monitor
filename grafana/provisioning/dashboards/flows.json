          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM \"NetworkFlow\" WHERE $__timeFilter(\"startedAt\") AND protocol = 'udp'",
