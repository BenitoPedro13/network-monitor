      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Flows" }]
      },
      "title": "Protocol / Port Breakdown",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT\n  protocol AS \"Protocol\",\n  \"dstPort\" AS \"Port\",\n  count(*) AS \"Flows\",\n  sum(bytes)::bigint AS \"Bytes\"\nFROM \"NetworkFlow\"\nWHERE $__timeFilter(\"startedAt\")\nGROUP BY 1,2\nORDER BY \"Flows\" DESC\nLIMIT 25",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
