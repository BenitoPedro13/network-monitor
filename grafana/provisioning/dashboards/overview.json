      "title": "Unique Domains",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT COUNT(DISTINCT \"queriedHost\") as value FROM \"DnsEvent\" WHERE $__timeFilter(\"queriedAt\")",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
