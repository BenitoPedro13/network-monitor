      "title": "Blocked Queries",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) as value FROM \"DnsEvent\" WHERE $__timeFilter(\"queriedAt\") AND blocked = true",
