        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Active Devices",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT COUNT(DISTINCT \"deviceId\") as value FROM \"DnsEvent\" WHERE $__timeFilter(\"queriedAt\")",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Queries Over Time (by Device)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(e.\"queriedAt\", $__interval),\n  d.name as metric,\n  count(*) as value\nFROM \"DnsEvent\" e\nJOIN \"Device\" d ON e.\"deviceId\" = d.id\nWHERE $__timeFilter(e.\"queriedAt\")\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Queries" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Queries" }]
      },
      "title": "Top Queried Domains",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT\n  \"queriedHost\" as \"Domain\",\n  count(*) as \"Queries\"\nFROM \"DnsEvent\"\nWHERE $__timeFilter(\"queriedAt\")\nGROUP BY \"queriedHost\"\nORDER BY \"Queries\" DESC\nLIMIT 20",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Queries" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Queries" }]
      },
      "title": "Top Destinations (Country / ISP)",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(g.country, 'Unknown') as \"Country\",\n  COALESCE(g.isp, 'Unknown') as \"ISP\",\n  count(*) as \"Queries\"\nFROM \"DnsEvent\" e\nLEFT JOIN \"IpGeoCache\" g ON e.\"responseIp\" = g.ip\nWHERE $__timeFilter(e.\"queriedAt\")\n  AND e.\"responseIp\" IS NOT NULL\nGROUP BY g.country, g.isp\nORDER BY \"Queries\" DESC\nLIMIT 15",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Open Alerts",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) as value FROM \"Alert\" WHERE status = 'OPEN'",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-main" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Risk" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "blue", "value": null },
                    { "color": "yellow", "value": 31 },
                    { "color": "orange", "value": 61 },
                    { "color": "red", "value": 81 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Risk" }]
      },
      "title": "Open Alerts",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-main" },
          "format": "table",
          "rawSql": "SELECT\n  a.\"createdAt\" as \"Created\",\n  d.name as \"Device\",\n  a.type as \"Type\",\n  a.title as \"Title\",\n  a.\"riskScore\" as \"Risk\"\nFROM \"Alert\" a\nJOIN \"Device\" d ON a.\"deviceId\" = d.id\nWHERE a.status = 'OPEN'\nORDER BY a.\"riskScore\" DESC, a.\"createdAt\" DESC\nLIMIT 100",
          "refId": "A"
        }
      ]
    }
  ],
