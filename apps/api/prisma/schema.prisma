generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AlertType {
  UNKNOWN_DOMAIN
  HIGH_FREQUENCY
  THREAT_MATCH
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Device {
  id          String     @id @default(cuid())
  name        String
  ipAddress   String     @unique
  macAddress  String?    @unique
  owner       String?
  deviceType  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dnsEvents   DnsEvent[]
  alerts      Alert[]
}

model DnsEvent {
  id          String   @id @default(cuid())
  queriedHost String
  queryType   String   @default("A")
  sourceIp    String
  responseIp  String?
  blocked     Boolean  @default(false)
  queriedAt   DateTime
  createdAt   DateTime @default(now())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, queriedAt, queriedHost])
  @@index([deviceId, queriedAt])
  @@index([queriedHost, queriedAt])
}

model IpGeoCache {
  ip          String   @id
  country     String?
  countryCode String?
  city        String?
  lat         Float?
  lon         Float?
  asn         String?
  isp         String?
  resolvedAt  DateTime @default(now())
}

model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NetworkFlow {
  id          String   @id @default(cuid())
  uid         String?  @unique
  srcIp       String
  dstIp       String
  dstPort     Int
  protocol    String
  service     String?
  serverName  String?
  bytes       BigInt
  duration    Float?
  connState   String?
  startedAt   DateTime
  deviceId    String?
  hadDnsQuery Boolean?
  createdAt   DateTime @default(now())

  @@index([deviceId, startedAt])
  @@index([dstIp, startedAt])
}

model Alert {
  id          String      @id @default(cuid())
  type        AlertType
  status      AlertStatus @default(OPEN)
  title       String
  description String?
  riskScore   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deviceId    String
  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
}
