POSTGRES_USER=network_monitor
POSTGRES_PASSWORD=network_monitor
POSTGRES_DB=network_monitor
POSTGRES_PORT=5433
DATABASE_URL=postgresql://network_monitor:network_monitor@localhost:5433/network_monitor?schema=public

# AdGuard Home runs as a native service (not Docker) on ports 53 (DNS) and 3000 (web UI).
# Bootstrap renders its config from adguardhome/AdGuardHome.template.yaml with these credentials.

# AdGuard Home credentials (used to render the AdGuard config — no wizard needed)
ADGUARD_URL=http://localhost:3000
ADGUARD_USER=admin
ADGUARD_PASSWORD=

# MaxMind GeoLite2 (register free at maxmind.com to get a license key)
# After registering, run: pnpm run geoip:update
# Paths are resolved automatically from the monorepo root — no path config needed
MAXMIND_LICENSE_KEY=
GEO_UPDATE_INTERVAL_DAYS=7

# Collector
COLLECTOR_POLL_INTERVAL_MS=30000
COLLECTOR_BACKFILL_HOURS=24

# Flow ingest (Zeek sensor; see scripts/zeek-sensor.sh)
FLOW_POLL_INTERVAL_MS=30000

# Grafana (http://localhost:3001)
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=network_monitor
